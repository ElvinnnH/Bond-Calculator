{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Streamlit Bond Calculator",
			"type": "shell",
			"command": "${workspaceFolder}/.venv/bin/python",
			"args": [
				"-m",
				"streamlit",
				"run",
				"bond_calculator.py",
				"--server.port",
				"8501",
				"--server.address",
				"0.0.0.0"
			],
			"group": "build",
			"isBackground": true,
			"problemMatcher": []
		}
	]
}